# Public host shown in the UI, embeds, and daily report. Empty uses https://rao.space2.world.
NEXT_PUBLIC_SITE_URL=https://rao.space2.world

# Local operator. The username is fixed as rao-admin. Never commit a real password.
RAO_ADMIN_PASSWORD=
# Optional session signing secret. Empty falls back to RAO_ADMIN_PASSWORD.
RAO_SESSION_SECRET=

# Optional supporting reader. Empty means the built-in local model. Never commit a real key.
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=

# Online archive. Both URL and service role key must be set or history stays on this machine.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional aliases read when the two names above are empty. Leave blank on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Database password for the operator or Supabase CLI. The app does not read this name.
SUPABASE_DB_PASSWORD=

# Custom RAO lane endpoint. Both must be non-empty or lanes stay on local rehearsal. Not an xAI path.
RAO_GROK_ENDPOINT=
RAO_GROK_CREDENTIAL=
